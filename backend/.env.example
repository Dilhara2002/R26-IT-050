# Server
PORT=5001

# Python itinerary and landmark-recognition service
PYTHON_AI_URL=http://127.0.0.1:5002
AI_SERVICE_PORT=5002
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LANDMARK_ENABLE_SVM=true

# Frontend defaults align with the integrated Node backend on port 5001.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api
# EXPO_PUBLIC_ITINERARY_API_BASE_URL=http://localhost:5001/api/itinerary

# MongoDB (optional; MongoDB features are limited when omitted)
MONGO_URI=your_mongodb_connection_string

# Admin pricing portal (change these values before deployment)
ADMIN_EMAIL=admin@ceylongo.lk
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
GEOAPIFY_API_KEY=your_geoapify_api_key

# LiteAPI / Nuitee Connect hotel availability and room pricing
LITEAPI_KEY=your_liteapi_sandbox_key
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_CURRENCY=USD
LITEAPI_GUEST_NATIONALITY=LK

# Local Ollama preference extraction. The package generator falls back to
# deterministic schema matching when Ollama is unavailable or times out.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_MS=30000

# Disabled by default because loading a local 8B model during route resolution
# can consume significant memory. Geoapify/Nominatim remain the normal resolvers.
ENABLE_OLLAMA_LOCATION_RESOLVER=false

# Optional Python interpreter override.
# When omitted, npm run ai-service uses backend/.venv311/bin/python.
# PYTHON_BIN=/absolute/path/to/backend/.venv311/bin/python
