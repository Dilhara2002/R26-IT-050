# Server
PORT=5001

# Python itinerary and landmark-recognition service
PYTHON_AI_URL=http://127.0.0.1:5002
AI_SERVICE_PORT=5002

# Frontend defaults align with the integrated Node backend on port 5001.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:5001/api
# EXPO_PUBLIC_ITINERARY_API_BASE_URL=http://localhost:5001/api/itinerary

# MongoDB (optional; MongoDB features are limited when omitted)
MONGO_URI=your_mongodb_connection_string

# Admin pricing portal (change these values before deployment)
ADMIN_EMAIL=admin@ceylongo.lk
ADMIN_PASSWORD=choose_a_strong_password
ADMIN_TOKEN_SECRET=replace_with_a_long_random_secret

# Neo4j Knowledge Graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key
GEOAPIFY_API_KEY=your_geoapify_api_key

# Optional Python interpreter override.
# When omitted, the backend uses backend/.venv/bin/python by default.
# PYTHON_BIN=/absolute/path/to/backend/.venv/bin/python
