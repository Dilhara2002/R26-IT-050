
# ==========================================
# CeylonGo Frontend Environment Configuration
# ==========================================

# Optional environment overrides.
# In Expo development, the frontend can automatically
# detect the Metro host for backend and AI services,
# when supported by the API client configuration.

# ==========================================
# Node.js Backend API (Port 5001)
# ==========================================

# Local computer development:
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/api

# Physical device development:
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5001/api

# ==========================================
# Itinerary API
# ==========================================

# Local computer development:
# EXPO_PUBLIC_ITINERARY_API_BASE_URL=http://127.0.0.1:5001/api/itinerary

# Physical device development:
# EXPO_PUBLIC_ITINERARY_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5001/api/itinerary

# ==========================================
# Python AI Service (Port 5002)
# ==========================================

# Local computer development:
# EXPO_PUBLIC_AI_SERVICE_BASE_URL=http://127.0.0.1:5002

# Physical device development:
# EXPO_PUBLIC_AI_SERVICE_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5002

# ==========================================
# Notes
# ==========================================

# Keep overrides commented when using automatic
# Metro host detection.

# Uncomment the relevant variables if manual
# API configuration is required.

# For physical devices, never use localhost.
# Replace YOUR_COMPUTER_LAN_IP with the
# development computer's actual LAN IP.

# If the Node backend is running on port 8080,
# replace port 5001 with 8080.
