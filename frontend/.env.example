# Optional overrides. Expo development automatically uses the Metro host for
# the Node API (5001) and Python AI service (5002), including on physical phones.
# EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5001/api
# EXPO_PUBLIC_ITINERARY_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5001/api/itinerary
# Optional override. In Expo development the landmark client automatically uses
# the Metro host on port 5002, which also works from a physical phone.
# EXPO_PUBLIC_AI_SERVICE_BASE_URL=http://YOUR_COMPUTER_LAN_IP:5002
